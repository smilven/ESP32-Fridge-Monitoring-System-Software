public function download($sensor_id)
{
    $logs = TemperatureLog::where('sensor_id', $sensor_id)
        ->orderBy('recorded_at', 'asc')
        ->get();

return response()->streamDownload(function() use ($logs) {
    $handle = fopen('php://output', 'w');

    fputcsv($handle, ['Temperature', 'Recorded At', 'Alert Status', 'Duration (Minutes)']);

    foreach ($logs as $log) {
        $minutes = ($log->duration_minutes < 0) ? 0 : abs($log->duration_minutes);
        $durationDisplay = ($log->alert_status == 1) ? $minutes . ' min' : '0';

        fputcsv($handle, [
            $log->temperature,
            $log->recorded_at,
            $log->alert_status == 1 ? 'Alert' : 'Normal',
            $durationDisplay
        ]);
    }

    fclose($handle);
}, 'TimeStamp_Temperature_Logs.csv', [
    'Content-Type' => 'text/csv',
    'Content-Disposition' => 'attachment; filename="TimeStamp_Temperature_Logs.csv"',
]);
}
